# Local iReal Pro chart lists to import + scratch (not distributed).
# iReal Pro exports are named "<Playlist> <songCount>.html" (a trailing space
# + number), which the app's own HTML (index.html, spike-strudel.html, …) is
# not — so this glob catches the chart lists without touching app files.
* [0-9]*.html
